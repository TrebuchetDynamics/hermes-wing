Future<void> verifyPrivateBootstrap() async {
  final runtime = _SpyRuntime();
  final callbacks = <void Function()>[];
  final pending = runZoned(
    () => _bootstrap(runtime),
    zoneSpecification: ZoneSpecification(
      scheduleMicrotask: (self, parent, zone, callback) =>
          callbacks.add(callback),
    ),
  );
  final completed = Completer<M2BootstrapResult>();
  pending.then(completed.complete, onError: completed.completeError);
  void zero() {
    if (runtime.counts.values.any((count) => count != 0)) {
      throw StateError(
        'REG-DEFAULT construction/start/I/O/launch: ${runtime.counts}',
      );
    }
  }

  zero();
  // Complete only recorded microtasks; no wall clock or plugin callbacks.
  while (callbacks.isNotEmpty) {
    callbacks.removeAt(0)();
  }
  final result = await completed.future;
  if (result.code != 'not_admitted' ||
      result.continuation != 'continuation_unavailable' ||
      result.qualifies) {
    throw StateError('REG-DEFAULT sanitized refusal');
  }
  zero();
  while (callbacks.isNotEmpty) {
    callbacks.removeAt(0)();
  }
  zero();
}
